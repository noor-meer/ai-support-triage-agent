              "content": "=You are a customer support triage assistant. Read the following support email and classify it.\n\nEmail Subject: {{ $json.Subject }}\nEmail Body: {{ $json.snippet }}\n\nRespond ONLY with valid JSON in this exact format, no extra text, no markdown formatting:\n{\n  \"category\": \"billing\" or \"bug\" or \"general_question\" or \"urgent_complaint\",\n  \"urgency\": \"low\" or \"medium\" or \"high\",\n  \"sentiment\": \"positive\" or \"neutral\" or \"negative\" or \"angry\",\n  \"confidence\": a number from 0 to 100,\n  \"reasoning\": \"a short one-sentence explanation of your classification\"\n}"
            }
          ]
        },
        "options": {}
      },
